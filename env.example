# Persistent PostgreSQL database for production
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Admin credentials: generate a bcrypt hash for your password and put it here.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="$2b$12$REPLACE_WITH_BCRYPT_HASH"
# Long random secret, at least 32 characters
SESSION_SECRET="replace-with-a-long-random-secret"
